{
  "name": "signum-smartc-testbed",
  "version": "1.2.0",
  "description": "A testbed for faster smart contract development with SmartC for Signum blockchain platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "compile": "tsc",
    "build": "npm run compile && ./build.sh",
    "prepare": "husky install",
    "lint": "lint-staged",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohager/signum-smartc-testbed.git"
  },
  "keywords": [
    "signum",
    "blockchain",
    "smartcontracts",
    "web3",
    "smartc",
    "clang",
    "c"
  ],
  "author": "ohager",
  "contributors": [
    "deleterium"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ohager/signum-smartc-testbed/issues"
  },
  "homepage": "https://github.com/ohager/signum-smartc-testbed#readme",
  "dependencies": {
    "smartc-signum-compiler": "2.3.0",
    "smartc-signum-simulator": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.8.3",
    "typedoc": "^0.28.19",
    "typedoc-plugin-missing-exports": "^4.1.3",
    "typedoc-theme-oxide": "^0.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
